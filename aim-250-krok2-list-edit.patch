+  const prevGroups = grouping ? (grouping.columnIds?.length ? grouping.columnIds : grouping.columnId ? [grouping.columnId] : []) : [];
+  const g = nextGrouping(grouping, prevGroups.filter((id) => !removed.includes(id)),
