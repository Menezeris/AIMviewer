+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { inLockedPlan, offerKey, orbitAttempted, startPress, ORBIT_ATTEMPT_PX } from './planOrbitHint.js';
+
+describe('pokus o orbit v zamknutom pôdoryse (AIM #188)', () => {
+  it('ťah orbitovým gestom nad prah je pokus o orbit', () => {
+    const p = startPress(100, 100, 'orbit');
+    assert.equal(orbitAttempted(p, 100 + ORBIT_ATTEMPT_PX + 1, 100), true);
+    assert.equal(orbitAttempted(p, 100, 100 - ORBIT_ATTEMPT_PX - 1), true);
+  });
+
+  it('pravé tlačidlo ako fly sa berie ako orbit, rovnako ako v 3D', () => {
+    assert.equal(orbitAttempted(startPress(0, 0, 'fly'), 20, 0), true);
+  });
+
+  it('klik a malý pohyb ponuku nespustia', () => {
+    const p = startPress(100, 100, 'orbit');
+    assert.equal(orbitAttempted(p, 100, 100), false);
+    assert.equal(orbitAttempted(p, 100 + ORBIT_ATTEMPT_PX, 100 - ORBIT_ATTEMPT_PX), false);
+    assert.equal(orbitAttempted(null, 500, 500), false);
+  });
+
+  it('posun (pan) a nástroj ponuku nikdy nespustia', () => {
+    assert.equal(orbitAttempted(startPress(0, 0, 'pan'), 200, 200), false);
+    assert.equal(orbitAttempted(startPress(0, 0, 'tool'), 200, 200), false);
+  });
+
+  it('ponuka len v zamknutom pôdoryse v záložke, nie v 3D ani v splite', () => {
+    assert.equal(inLockedPlan({ sceneKind: 'plan', viewLocked: true, splitView: false }), true);
+    assert.equal(inLockedPlan({ sceneKind: '3d', viewLocked: true, splitView: false }), false);
+    assert.equal(inLockedPlan({ sceneKind: 'plan', viewLocked: false, splitView: false }), false);
+    assert.equal(inLockedPlan({ sceneKind: 'plan', viewLocked: true, splitView: true }), false);
+    assert.equal(inLockedPlan({ sceneKind: undefined, viewLocked: true, splitView: false }), false);
+  });
+
+  it('Enter a medzerník prijmú, Esc zavrie, fokus na ovládacom prvku kláves nechá jemu', () => {
+    assert.equal(offerKey('Enter', 'BODY', false), 'accept');
+    assert.equal(offerKey(' ', 'CANVAS', false), 'accept');
+    assert.equal(offerKey('Escape', 'INPUT', true), 'dismiss');
+    assert.equal(offerKey('Enter', 'BUTTON', false), null);
+    assert.equal(offerKey(' ', 'INPUT', false), null);
+    assert.equal(offerKey('Enter', 'DIV', true), null);
+    assert.equal(offerKey('a', 'BODY', false), null);
+  });
+});
diff --git a/apps/viewer/src/aim/planOrbitHint.ts b/apps/viewer/src/aim/planOrbitHint.ts
new file mode 100644
index 00000000..ade706d8
--- /dev/null
+++ b/apps/viewer/src/aim/planOrbitHint.ts
@@ -0,0 +1,58 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/**
+ * Pokus o orbit v zamknutom pôdoryse (AIM #188, D-132) - čisté rozhodnutia bez
+ * Reactu a store. Pôdorys je kolmý pohľad zhora, ťah sa v ňom mení na posun
+ * (`useMouseControls.ts`), takže orbit nedá žiadnu odozvu. Ponuka prepnúť do 3D
+ * sa ukáže, keď sa ťahá gestom, ktoré by v 3D orbitovalo (`orbit`, alebo
+ * pravé tlačidlo ako `fly`), nie gestom posunu (`pan`, nástroj, stredné
+ * tlačidlo, Shift). Gesto rozhoduje upstream `resolveNavigationPointerGesture`
+ * (D-098), tu sa len vyhodnotí.
+ */
+
+import type { ViewTabKind } from './viewTabsLayout.js';
+
+export type DragGesture = 'fly' | 'orbit' | 'pan' | 'tool';
+
+/** Ťah menší než toto (px) je klik, nie pokus o orbit; ako `didDrag` v upstreame. */
+export const ORBIT_ATTEMPT_PX = 5;
+
+/** Ponuka zmizne sama po tomto čase (ms). */
+export const OFFER_TIMEOUT_MS = 8000;
+
+/** Gesto, ktoré by v 3D otáčalo pohľad. */
+export const isOrbitGesture = (g: DragGesture): boolean => g === 'orbit' || g === 'fly';
+
+export interface Press { x: number; y: number; orbit: boolean }
+
+export const startPress = (x: number, y: number, gesture: DragGesture): Press => ({ x, y, orbit: isOrbitGesture(gesture) });
+
+/** Pokus o orbit nastal: ťah orbitovým gestom prešiel prah. */
+export function orbitAttempted(p: Press | null, x: number, y: number): boolean {
+  return p !== null && p.orbit && (Math.abs(x - p.x) > ORBIT_ATTEMPT_PX || Math.abs(y - p.y) > ORBIT_ATTEMPT_PX);
+}
+
+export interface SceneFlags {
+  /** Druh záložky, ktorej stav je v canvase. */
+  sceneKind: ViewTabKind | undefined;
+  viewLocked: boolean;
+  splitView: boolean;
+}
+
+/** Ponuka patrí len zamknutému pôdorysu v záložke (nie 3D, nie split vedľa voľnej 3D). */
+export const inLockedPlan = (f: SceneFlags): boolean => f.sceneKind === 'plan' && f.viewLocked && !f.splitView;
+
+export type OfferKey = 'accept' | 'dismiss' | null;
+
+/**
+ * Kláves k ponuke: Enter a medzerník prijmú, Esc zavrie. Ak je fokus na
+ * ovládacom prvku (tlačidlo, pole, výber), kláves patrí jemu.
+ */
+export function offerKey(key: string, targetTag: string, editable: boolean): OfferKey {
+  if (key === 'Escape') return 'dismiss';
+  if (key !== 'Enter' && key !== ' ') return null;
+  if (editable || ['BUTTON', 'INPUT', 'TEXTAREA', 'SELECT', 'A'].includes(targetTag)) return null;
+  return 'accept';
+}
