--- a/apps/viewer/src/aim/aimInspectorStore.ts
+++ b/apps/viewer/src/aim/aimInspectorStore.ts
@@ -23,11 +23,20 @@ export interface PropertyFocusState {
 interface AimInspectorState {
   propertyFocus: PropertyFocusState | null;
   setPropertyFocus: (focus: PropertyFocusState | null) => void;
+  /** Zastaví bežiace zvýraznenie (observer, takt); registruje ho lenivý `aimPanelView`. */
+  stopFocus: (() => void) | null;
+  /** Nová relácia mosta: zvýraznenie z predošlej sa zastaví a zabudne (AIM D-127). */
+  resetFocus: () => void;
 }
 
-export const useAimInspectorStore = create<AimInspectorState>((set) => ({
+export const useAimInspectorStore = create<AimInspectorState>((set, get) => ({
   propertyFocus: null,
   setPropertyFocus: (propertyFocus) => set({ propertyFocus }),
+  stopFocus: null,
+  resetFocus: () => {
+    get().stopFocus?.();
+    set({ propertyFocus: null });
+  },
 }));
 
