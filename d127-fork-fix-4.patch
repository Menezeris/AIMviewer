 import assert from 'node:assert';
 
 import { isInboundMessage } from './bridge-protocol.js';
+import { useAimInspectorStore } from './aimInspectorStore.js';
 import { focusSections, isQuantitySetName, matchName, panelPlan, parsePanelView, propKeyEntity, selectPanel } from './aimPanelViewPlan.js';
 
 const S = 'aim-bridge' as const;
@@ -70,4 +71,13 @@ describe('panel vlastností z chatu (AIM D-113)', () => {
     assert.equal(matchName(['Height', ' width '], 'Width'), 1);
     assert.equal(matchName([null, undefined, 'Area'], 'Width'), -1);
   });
+
+  it('nová relácia mosta zastaví bežiace zvýraznenie a zabudne výsledok', () => {
+    let stopped = 0;
+    useAimInspectorStore.setState({ stopFocus: () => { stopped += 1; } });
+    useAimInspectorStore.getState().setPropertyFocus({ pset: 'P', property: 'X', found: true });
+    useAimInspectorStore.getState().resetFocus();
+    assert.equal(stopped, 1);
+    assert.equal(useAimInspectorStore.getState().propertyFocus, null);
+  });
 });
