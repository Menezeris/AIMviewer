{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "aliases": {
   "default": [],
   "description": "[V18] udržiava writer: vždy obsahuje `id` (Obsidian návrhár, Dataview)",
   "items": {
    "type": "string"
   },
   "title": "Aliasy",
   "type": "array",
   "x-assetin": {
    "zdroj": "frontmatter"
   }
  },
  "autor": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Autor",
   "x-assetin": {
    "export": "authoring/author",
    "zdroj": "frontmatter"
   }
  },
  "guid": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "generuje nástroj",
   "title": "GUID",
   "x-assetin": {
    "export": "specId/guid ; dt:GUID",
    "zdroj": "frontmatter"
   }
  },
  "id": {
   "description": "prefix + číslo alebo cesta; nesie ho cesta súboru (§0.4), vo frontmatter kópia",
   "title": "ID",
   "type": "string",
   "x-assetin": {
    "export": "29481-3 specId/localCode ; 7817-3 name",
    "zdroj": "frontmatter"
   }
  },
  "jazyk": {
   "default": "sk",
   "description": "ISO 639-1",
   "title": "Jazyk",
   "type": "string",
   "x-assetin": {
    "export": "uc/language",
    "zdroj": "frontmatter"
   }
  },
  "licencia": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Licencia",
   "x-assetin": {
    "export": "authoring/copyright",
    "zdroj": "frontmatter"
   }
  },
  "nazov": {
   "title": "Názov",
   "type": "string",
   "x-assetin": {
    "zdroj": "frontmatter"
   }
  },
  "nazov_en": {
   "minLength": 1,
   "title": "Názov (EN)",
   "type": "string",
   "x-assetin": {
    "export": "specId/shortTitle ; 7817-3 Purpose/Language",
    "zdroj": "frontmatter"
   }
  },
  "prepisuje": {
   "default": [],
   "description": "projekt: STD-projekt prepisuje:: [[STD]]",
   "items": {
    "pattern": "^\\[\\[[^\\[\\]]+\\]\\]$",
    "type": "string",
    "x-assetin": {
     "widget": "wikilink"
    }
   },
   "title": "Prepisuje",
   "type": "array",
   "x-assetin": {
    "cielove_typy": [
     "STD"
    ],
    "kotva": "ziadna",
    "widget": "wikilink",
    "zdroj": "inline"
   }
  },
  "stav": {
   "enum": [
    "NP",
    "WD",
    "PUB",
    "WDRL"
   ],
   "title": "Stav",
   "type": "string",
   "x-assetin": {
    "export": "documentStatus",
    "zdroj": "frontmatter"
   }
  },
  "typ": {
   "enum": [
    "GOAL",
    "UC",
    "ER",
    "IU-O",
    "IU-C",
    "STD",
    "GEO",
    "PROP",
    "DEF",
    "EV",
    "ACT",
    "PROT",
    "PROJ"
   ],
   "title": "Typ",
   "type": "string",
   "x-assetin": {
    "zdroj": "frontmatter"
   }
  },
  "verzia": {
   "title": "Verzia",
   "type": "string",
   "x-assetin": {
    "export": "specId/version",
    "zdroj": "frontmatter"
   }
  }
 },
 "required": [
  "id",
  "typ",
  "nazov",
  "nazov_en",
  "stav",
  "verzia"
 ],
 "title": "STD",
 "type": "object",
 "x-assetin": {
  "pod_zaznamy": [
   "pravidlo",
   "profil",
   "slovnik"
  ],
  "schema_verzia": "1.5",
  "sekcie": [],
  "typ": "STD"
 }
}
