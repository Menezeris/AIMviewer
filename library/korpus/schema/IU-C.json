  "Mvd": {
   "additionalProperties": false,
   "description": "[V26] Model view definition of the container → 29481-3 ``correspondingMvd``.\n\nA container says which view of the schema it is delivered in (IFC4X3_ADD2 / Reference View);\nwithout it the IDS generator has to guess which entities and property sets may appear at all.\nField names are the normative ones, like ``Dokument.type/form/content``.",
   "properties": {
    "basis": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "schéma, nad ktorou MVD stojí",
     "title": "Základ",
     "x-assetin": {
      "zdroj": "frontmatter"
     }
    },
    "name": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "napr. Reference View",
     "title": "Názov",
     "x-assetin": {
      "zdroj": "frontmatter"
     }
    }
   },
   "title": "Mvd",
   "type": "object"
  },
  "Priradenie": {
   "additionalProperties": false,
   "description": "[V27] Assignment container → object type, optionally narrowed to LOIN aspects.\n\nThe same room is in the IFC model (geometry + alphanumerics) and in the survey report (only the\ndocumentation aspect). Without ``rozsah`` the report would look as if it had to satisfy the whole\nLOIN of the room; with it, the generator takes from a container only what is in scope\n(LOIN-05 §11.5 a; PAS 6.3.2.1 b — the LOIN frame structures the unit, it does not replace it).\n\nEmpty ``rozsah`` means every aspect the IU-O defines at all, not „nothing\".",
   "properties": {
    "iu": {
     "pattern": "^\\[\\[[^\\[\\]]+\\]\\]$",
     "title": "Objekt",
     "type": "string",
     "x-assetin": {
      "cielove_typy": [
       "IU-O"
      ],
      "export": "subInformationUnit",
      "kotva": "ziadna",
      "widget": "wikilink",
      "zdroj": "frontmatter"
     }
    },
    "rozsah": {
     "default": [],
     "description": "[V27] prázdne = všetky aspekty, ktoré daná IU-O definuje (7817-1 tri zložky LOIN)",
     "items": {
      "enum": [
       "geometria",
       "alfanumerika",
       "dokumentacia"
      ],
      "type": "string"
     },
     "title": "Rozsah aspektov",
     "type": "array",
     "x-assetin": {
      "zdroj": "frontmatter"
     }
    }
   },
   "required": [
    "iu"
   ],
   "title": "Priradenie",
   "type": "object"
  },
