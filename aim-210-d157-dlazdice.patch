+    assert.strictEqual(tileScene({ ...s, activeId: 'plan:G2' }, t, '3d'), 'plan:G2');
+    assert.strictEqual(tileScene({ ...s, activeId: 'doc:A' }, t, 'plan:G1'), 'plan:G1');
