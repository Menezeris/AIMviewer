diff --git a/apps/viewer/src/aim/tileShots.ts b/apps/viewer/src/aim/tileShots.ts
new file mode 100644
index 00000000..e5a54c95
--- /dev/null
+++ b/apps/viewer/src/aim/tileShots.ts
@@ -0,0 +1,57 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/**
+ * Snímky 3D dlaždíc (AIM D-157): viewer má jeden 3D canvas, preto 3D dlaždica
+ * mimo živej ukazuje posledný obraz svojej záložky. Snímka sa robí synchrónne
+ * pri odchode záložky z canvasu (kópia posledného zobrazeného snímku do 2D
+ * canvasu, zmenšená), nie z renderera; nič sa neprekresľuje navyše. Len počas
+ * relácie, zabudne sa so záložkou.
+ */
+
+import { useAimViewTabs } from './viewTabsStore.js';
+
+/** Dlhšia strana snímky v px (4 dlaždice x 1600 px = pamäť pár MB). */
+const MAX_SIDE = 1600;
+
+const shots = new Map<string, HTMLCanvasElement>();
+
+const viewportCanvas = () => document.querySelector<HTMLCanvasElement>('canvas[data-viewport="main"]');
+
+const bump = () => useAimViewTabs.setState((s) => ({ shots: s.shots + 1 }));
+
+/** Odfotí 3D canvas ako snímku záložky `id`; false = canvas nie je alebo je prázdny. */
+export function shoot(id: string): boolean {
+  const src = viewportCanvas();
+  if (!src || src.width === 0 || src.height === 0) return false;
+  const k = Math.min(1, MAX_SIDE / Math.max(src.width, src.height));
+  const out = shots.get(id) ?? document.createElement('canvas');
+  out.width = Math.max(1, Math.round(src.width * k));
+  out.height = Math.max(1, Math.round(src.height * k));
+  const ctx = out.getContext('2d');
+  if (!ctx) return false;
+  try {
+    ctx.drawImage(src, 0, 0, out.width, out.height);
+  } catch {
+    return false;
+  }
+  shots.set(id, out);
+  bump();
+  return true;
+}
+
+export const shotOf = (id: string) => shots.get(id) ?? null;
+export const hasShot = (id: string) => shots.has(id);
+
+/** Zabudne snímky zavretých záložiek. */
+export function pruneShots(open: ReadonlySet<string>): void {
+  let changed = false;
+  for (const id of shots.keys()) {
+    if (!open.has(id)) {
+      shots.delete(id);
+      changed = true;
+    }
+  }
+  if (changed) bump();
+}
diff --git a/apps/viewer/src/aim/tiles-protocol.ts b/apps/viewer/src/aim/tiles-protocol.ts
new file mode 100644
index 00000000..55b2b98a
--- /dev/null
+++ b/apps/viewer/src/aim/tiles-protocol.ts
@@ -0,0 +1,46 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/**
+ * Dlaždice z chatu (AIM D-157, #210): `VIEW_TABS` s akciou `layout` nastaví
+ * rozloženie a záložku každej dlaždice. Vlastný modul (mimo `tabs-protocol.ts`,
+ * ktorý číta aj vstupný balík), overuje ho až lenivé vykonanie záložiek.
+ *
+ * Dlaždica na drôte: `{tab}` = otvorená záložka (id, `3d`, menovka alebo GlobalId
+ * podlažia), `{plan}` = pôdorys podlažia podľa GlobalId (otvorí sa, ak nie je),
+ * null = prázdna dlaždica. Chýbajúce dlaždice doplní viewer otvorenými záložkami.
+ */
+
+import { SOURCE } from './bridge-protocol.js';
+import { TILE_RECTS, isTileLayout, type TileLayout } from './viewTilesPlan.js';
+
+export type TileWire = { tab: string } | { plan: string } | null;
+
+export interface TilesMessage {
+  source: typeof SOURCE;
+  type: 'VIEW_TABS';
+  action: 'layout';
+  layout: TileLayout;
+  tiles?: TileWire[];
+}
+
+const MAX_TEXT = 200;
+const isText = (v: unknown) => typeof v === 'string' && v.trim().length > 0 && v.length <= MAX_TEXT;
+
+function isTile(v: unknown): v is TileWire {
+  if (v === null) return true;
+  if (!v || typeof v !== 'object' || Array.isArray(v)) return false;
+  const keys = Object.keys(v);
+  const o = v as Record<string, unknown>;
+  if (keys.length !== 1) return false;
+  return keys[0] === 'tab' ? isText(o.tab) : keys[0] === 'plan' ? isText(o.plan) : false;
+}
+
+export function isTilesMessage(data: unknown): data is TilesMessage {
+  if (!data || typeof data !== 'object') return false;
+  const m = data as Record<string, unknown>;
+  if (m.source !== SOURCE || m.type !== 'VIEW_TABS' || m.action !== 'layout' || !isTileLayout(m.layout)) return false;
+  if (m.tiles === undefined) return true;
+  return Array.isArray(m.tiles) && m.tiles.length <= TILE_RECTS[m.layout].length && m.tiles.every(isTile);
+}
