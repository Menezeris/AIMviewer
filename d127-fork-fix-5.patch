diff --git a/apps/viewer/src/aim/aimPanelView.ts b/apps/viewer/src/aim/aimPanelView.ts
index cafd16c4..d261d0f1 100644
--- a/apps/viewer/src/aim/aimPanelView.ts
+++ b/apps/viewer/src/aim/aimPanelView.ts
@@ -17,7 +17,7 @@
 
 import { useViewerStore } from '../store/index.js';
 import { useAimInspectorStore, type PropertyFocusState } from './aimInspectorStore.js';
-import { focusSections, matchName, panelPlan, propKeyEntity, type AimPanelView, type PanelSection } from './aimPanelViewPlan.js';
+import { focusSections, matchName, panelPlan, propKeyEntity, quantityFromType, type AimPanelView, type PanelSection } from './aimPanelViewPlan.js';
 
 const SETTLE_TIMEOUT_MS = 5000;
 /** Ako dlho sa riadok hľadá v jednej sekcii, kým sa skúsi druhá (panel sa vykresľuje postupne). */
@@ -26,7 +26,7 @@ const FOCUS_ATTR = 'data-aim-focus';
 
 type Target = { modelId: string; expressId: number };
 type Focus = { pset: string; property: string };
-type Hit = { el: Element; section: PanelSection; fromType: boolean };
+type Hit = { el: Element; section: PanelSection; fromType?: boolean };
 
 let stopActive: (() => void) | null = null;
 
@@ -65,7 +65,11 @@ function locate(scope: ParentNode, focus: Focus, target: Target, section: PanelS
   if (section !== 'quantities') return null; // riadky psetov nesú `data-prop-key` vyššie
   const rows = [...(trigger.parentElement?.querySelectorAll('.group\\/copyrow') ?? [])];
   const j = matchName(rows.map((r) => r.querySelector('span.font-medium')?.textContent), focus.property);
-  return j < 0 ? null : { el: rows[j], section, fromType: false };
+  if (j < 0) return null;
+  // Výskyt je v DOM pred typom, takže pri rovnakom mene sady vyhrá výskyt (matchName = prvý zásah).
+  const box = trigger.closest('section');
+  const boxes = box?.parentElement ? [...box.parentElement.children].filter((c) => c.tagName === 'SECTION') : [];
+  return { el: rows[j], section, fromType: quantityFromType(box ? boxes.indexOf(box) : -1, boxes.length) };
 }
 
 /**
