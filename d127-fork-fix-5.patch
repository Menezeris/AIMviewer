 const GUID = '0MJFXziqDE$gGyPWwro9fJ';
@@ -80,4 +80,11 @@ describe('panel vlastností z chatu (AIM D-113)', () => {
     assert.equal(stopped, 1);
     assert.equal(useAimInspectorStore.getState().propertyFocus, null);
   });
+
+  it('výmera z typu: druhá sekcia Quantities je typ, pri jedinej sa to určiť nedá', () => {
+    assert.equal(quantityFromType(0, 2), false);
+    assert.equal(quantityFromType(1, 2), true);
+    assert.equal(quantityFromType(0, 1), undefined);
+    assert.equal(quantityFromType(-1, 0), undefined);
+  });
 });
diff --git a/apps/viewer/src/aim/aimPanelViewPlan.ts b/apps/viewer/src/aim/aimPanelViewPlan.ts
index 49cdb639..a8cb96ca 100644
--- a/apps/viewer/src/aim/aimPanelViewPlan.ts
+++ b/apps/viewer/src/aim/aimPanelViewPlan.ts
@@ -89,3 +89,13 @@ export function matchName(names: ReadonlyArray<string | null | undefined>, want:
   const exact = names.findIndex((n) => same(n, want));
   return exact >= 0 ? exact : names.findIndex((n) => sameLoose(n, want));
 }
+
+/**
+ * Výmera z typu? Panel kreslí v Quantities sekciu výskytu vždy pred sekciou typu a
+ * prázdnu vynechá: zásah v druhej sekcii je z typu, pri jedinej sekcii sa to z DOM
+ * určiť nedá (undefined).
+ */
+export function quantityFromType(sectionIndex: number, sectionCount: number): boolean | undefined {
+  if (sectionIndex < 0 || sectionCount < 2) return undefined;
+  return sectionIndex > 0;
+}
