+
+import { describe, it } from 'node:test';
+import assert from 'node:assert';
+
+import { isViewMessage, isPanelsRequest } from './view-protocol.js';
+import { describePanels, panelInfo, planPanels, type PanelsStateLike } from './aimPanelsPlan.js';
+
+const S = 'aim-bridge' as const;
+
+const base: PanelsStateLike = {
+  leftPanelCollapsed: false,
+  sidebarMode: 'expanded',
+  sidebarActivePanel: 'lens',
+  sidebarSecondaryPanel: null,
+  sidebarWidthPct: 22.4,
+  floatingPanels: [],
+  poppedOutIds: [],
+  listPanelVisible: false,
+};
+
+describe('panely z chatu (AIM D-127)', () => {
+  it('SET_PANELS: známe panely a akcie, all len close, aspoň jedna položka', () => {
+    assert.equal(isViewMessage({ source: S, type: 'SET_PANELS', panels: { lens: 'close' } }), true);
+    assert.equal(isViewMessage({ source: S, type: 'SET_PANELS', panels: { all: 'close', properties: 'open' } }), true);
+    assert.equal(isPanelsRequest({ all: 'open' }), false);
+    assert.equal(isPanelsRequest({ legend: 'close' }), false);
+    assert.equal(isPanelsRequest({ lens: 'hide' }), false);
+    assert.equal(isPanelsRequest({}), false);
+    assert.equal(isPanelsRequest([]), false);
+    assert.equal(isViewMessage({ source: S, type: 'SET_PANELS' }), false);
+  });
+
+  it('plán: all zavrie všetko okrem výslovne otvorených, zatváranie ide prvé, toggle podľa stavu', () => {
+    const open = new Set(['lens', 'model_tree']);
+    const steps = planPanels({ all: 'close', properties: 'open' }, (k) => open.has(k));
+    assert.deepEqual(steps.at(-1), { key: 'properties', open: true });
+    assert.equal(steps.filter((s) => s.open).length, 1);
+    assert.equal(steps.length, 6);
+    assert.deepEqual(planPanels({ lens: 'toggle', lists: 'toggle' }, (k) => open.has(k)), [
+      { key: 'lens', open: false },
+      { key: 'lists', open: true },
+    ]);
+  });
+
+  it('stav: ukotvený vpravo, vľavo, dole, plávajúci so snapom a veľkosťou, samostatné okno', () => {
+    assert.deepEqual(panelInfo(base, 'lens'), { open: true, where: 'right' });
+    assert.deepEqual(panelInfo(base, 'properties'), { open: false });
+    assert.deepEqual(panelInfo(base, 'model_tree'), { open: true, where: 'left' });
+    assert.deepEqual(panelInfo({ ...base, listPanelVisible: true }, 'lists'), { open: true, where: 'bottom' });
+    const floating = { ...base, floatingPanels: [{ id: 'lens', snap: 'right', w: 360.4, h: 459.6 }] };
+    assert.deepEqual(panelInfo(floating, 'lens'), { open: true, where: 'floating', snap: 'right', size: { w: 360, h: 460 } });
+    assert.deepEqual(panelInfo({ ...base, poppedOutIds: ['documents'] }, 'documents'), { open: true, where: 'window' });
+    assert.deepEqual(panelInfo({ ...base, sidebarMode: 'collapsed' }, 'lens'), { open: false });
+    assert.deepEqual(panelInfo({ ...base, sidebarSecondaryPanel: 'drawing-underlay' }, 'underlays'), { open: true, where: 'right' });
+    const all = describePanels(base);
+    assert.equal(all.right_width_pct, 22);
+    assert.equal(describePanels({ ...base, sidebarMode: 'collapsed' }).right_width_pct, null);
+  });
+});
diff --git a/apps/viewer/src/aim/aimPanelsPlan.ts b/apps/viewer/src/aim/aimPanelsPlan.ts
new file mode 100644
index 00000000..b7fde688
--- /dev/null
+++ b/apps/viewer/src/aim/aimPanelsPlan.ts
@@ -0,0 +1,85 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/**
+ * Panely z chatu (AIM D-127, #179): `SET_PANELS` otvorí, zavrie alebo prepne
+ * panely viewera a `view_state` / `APPLIED` vráti stav všetkých. Tu je rozpis akcií
+ * a opis stavu, bez store (mená a validácia drôtu sú vo `view-protocol.ts`, vykonanie
+ * v `aimPanels.ts`, lenivo cez `useAimViewCommands`).
+ *
+ * Mená na drôte -> panel upstreamu: `lens` -> `lens`, `properties` -> `properties`,
+ * `underlays` -> `drawing-underlay`, `documents` -> `documents`, `lists` -> `lists`
+ * (spodný pás), `model_tree` -> `hierarchy` (ľavý stĺpec). `all` = všetky.
+ */
+
+import { PANEL_KEYS, type PanelKey, type PanelsRequest } from './view-protocol.js';
+
+export { PANEL_KEYS, type PanelKey, type PanelsRequest };
+
+/** Panel upstreamu (`WorkspacePanelId`) pre meno na drôte. */
+export const PANEL_ID = {
+  lens: 'lens',
+  properties: 'properties',
+  underlays: 'drawing-underlay',
+  documents: 'documents',
+  lists: 'lists',
+  model_tree: 'hierarchy',
+} as const satisfies Record<PanelKey, string>;
+
+/**
+ * Konečné kroky: `all` zavrie všetky panely okrem tých, ktoré správa výslovne
+ * otvára ("zavri všetko okrem 3D a vlastností"); `toggle` sa rozhodne podľa stavu.
+ * Zatváranie ide pred otváraním, aby otvorený panel nezavrel spoločný slot.
+ */
+export function planPanels(req: PanelsRequest, isOpen: (key: PanelKey) => boolean): { key: PanelKey; open: boolean }[] {
+  const want = new Map<PanelKey, boolean>();
+  if (req.all === 'close') for (const k of PANEL_KEYS) want.set(k, false);
+  for (const k of PANEL_KEYS) {
+    const a = req[k];
+    if (a === 'open') want.set(k, true);
+    else if (a === 'close') want.set(k, false);
+    else if (a === 'toggle') want.set(k, !isOpen(k));
+  }
+  const steps = [...want].map(([key, open]) => ({ key, open }));
+  return [...steps.filter((s) => !s.open), ...steps.filter((s) => s.open)];
+}
+
+/** Stav store, z ktorého sa číta, kde panel je (podmnožina `ViewerState`). */
+export interface PanelsStateLike {
+  leftPanelCollapsed: boolean;
+  sidebarMode: string;
+  sidebarActivePanel: string;
+  sidebarSecondaryPanel: string | null;
+  sidebarWidthPct: number;
+  floatingPanels: ReadonlyArray<{ id: string; snap: string; w: number; h: number }>;
+  poppedOutIds: ReadonlyArray<string>;
+  listPanelVisible: boolean;
+}
+
+export interface PanelInfo {
+  open: boolean;
+  /** left | right | bottom = ukotvený, floating = plávajúce okno (snap, w, h px), window = samostatné okno. */
+  where?: 'left' | 'right' | 'bottom' | 'floating' | 'window';
+  snap?: string;
+  size?: { w: number; h: number };
+}
+
+/** Kde je panel (`key`) podľa stavu store. */
+export function panelInfo(s: PanelsStateLike, key: PanelKey): PanelInfo {
+  const id = PANEL_ID[key];
+  if (key === 'model_tree') return s.leftPanelCollapsed ? { open: false } : { open: true, where: 'left' };
+  const floating = s.floatingPanels.find((p) => p.id === id);
+  if (floating) return { open: true, where: 'floating', snap: floating.snap, size: { w: Math.round(floating.w), h: Math.round(floating.h) } };
+  if (s.poppedOutIds.includes(id)) return { open: true, where: 'window' };
+  if (key === 'lists') return s.listPanelVisible ? { open: true, where: 'bottom' } : { open: false };
