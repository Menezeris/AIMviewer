 /** Ako dlho po prvom posune sa riadok sleduje (panel sa dokresľuje najviac pár stoviek ms). */
 const FOLLOW_MS = 3000;
@@ -85,11 +87,114 @@ export function revealRow(getRow: () => Element | null): void {
