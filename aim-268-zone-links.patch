+    assert.equal(auto.manual, undefined);
+    assert.equal(hand.manual, true);
+    assert.equal(fake.manual, undefined);
+    assert.match(linkTitle(hand), /ručne priradené/);
+    assert.match(linkTitle(auto), /odvodené/);
