+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import { describe, it } from 'node:test';
+import assert from 'node:assert';
+
+import { fitTabs } from './viewTabsFit.js';
+
+const ids = ['3d', 'a', 'b', 'c', 'd', 'e'];
+const base = { ids, activeId: '3d', besideId: null, slotWidth: 100, moreWidth: 40 };
+
+describe('lišta záložiek: zoznam pretečených (AIM D-132, #240)', () => {
+  it('keď sa zmestia všetky, nič nie je skryté', () => {
+    assert.deepStrictEqual(fitTabs({ ...base, available: 600 }), { visible: ids, hidden: [] });
+  });
+
+  it('pri preteku sa odpočíta tlačidlo zoznamu a zvyšok ide do zoznamu', () => {
+    const r = fitTabs({ ...base, available: 400 }); // (400 - 40) / 100 = 3 miesta
+    assert.deepStrictEqual(r.visible, ['3d', 'a', 'b']);
+    assert.deepStrictEqual(r.hidden, ['c', 'd', 'e']);
+  });
+
+  it('aktívna záložka z preteku je viditeľná, poradie ostáva pôvodné', () => {
+    const r = fitTabs({ ...base, available: 400, activeId: 'e' });
+    assert.deepStrictEqual(r.visible, ['3d', 'a', 'e']);
+    assert.deepStrictEqual(r.hidden, ['b', 'c', 'd']);
+  });
+
+  it('záložka vedľa má prednosť pred ostatnými, aktívna pred záložkou vedľa', () => {
+    assert.deepStrictEqual(fitTabs({ ...base, available: 400, activeId: 'c', besideId: 'e' }).visible, ['3d', 'c', 'e']);
+    assert.deepStrictEqual(fitTabs({ ...base, available: 300, activeId: 'c', besideId: 'e' }).visible, ['3d', 'c']);
+  });
+
+  it('3D ostáva pripnutá aj v úzkej lište, aktívna sa nezmestí len keď je miesto jedno', () => {
+    assert.deepStrictEqual(fitTabs({ ...base, available: 20, activeId: 'c' }).visible, ['3d']);
+    assert.deepStrictEqual(fitTabs({ ...base, available: 20, activeId: 'c' }).hidden, ['a', 'b', 'c', 'd', 'e']);
+  });
+
+  it('neznáme id aktívnej alebo vedľa sa ignoruje', () => {
+    const r = fitTabs({ ...base, available: 400, activeId: 'zzz', besideId: 'yyy' });
+    assert.deepStrictEqual(r.visible, ['3d', 'a', 'b']);
+  });
+
+  it('presne na hranici sa zmestia všetky bez tlačidla', () => {
+    assert.strictEqual(fitTabs({ ...base, available: 600 }).hidden.length, 0);
+    assert.strictEqual(fitTabs({ ...base, available: 599 }).hidden.length, 1);
+  });
+});
diff --git a/apps/viewer/src/aim/viewTabsFit.ts b/apps/viewer/src/aim/viewTabsFit.ts
new file mode 100644
index 00000000..344390d8
--- /dev/null
+++ b/apps/viewer/src/aim/viewTabsFit.ts
@@ -0,0 +1,48 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+/**
+ * Lišta záložiek (AIM D-132, #240): ktoré záložky sa zmestia a ktoré idú do
+ * rozbaľovacieho zoznamu na konci lišty (ako v prehliadači alebo Revite).
+ * Čistá funkcia bez DOM; šírky dodá lišta z `ResizeObserver`.
+ *
+ * Pravidlá: keď sa zmestia všetky, zoznam sa nekreslí. Inak sa viditeľné miesta
+ * (po odpočítaní tlačidla zoznamu) plnia v poradí: 3D (vždy pripnutá prvá),
+ * aktívna, záložka vedľa, potom ostatné podľa poradia na lište. Viditeľné
+ * záložky ostávajú v pôvodnom poradí; aktívna sa teda do viditeľnej časti
+ * dostane sama, bez zmeny poradia v `view_state.tabs`.
+ */
+
+export interface FitInput {
+  /** Id záložiek v poradí na lište (prvá je 3D). */
+  ids: readonly string[];
+  activeId: string;
+  besideId: string | null;
+  /** Šírka jedného miesta záložky v px (menovka je orezaná na túto šírku). */
+  slotWidth: number;
+  /** Šírka tlačidla zoznamu v px. */
+  moreWidth: number;
+  /** Šírka lišty určená na záložky v px. */
+  available: number;
+}
+
+export interface FitResult {
+  visible: string[];
+  hidden: string[];
+}
+
+export function fitTabs({ ids, activeId, besideId, slotWidth, moreWidth, available }: FitInput): FitResult {
+  const slot = Math.max(1, slotWidth);
+  if (ids.length * slot <= available) return { visible: [...ids], hidden: [] };
+
+  // Aspoň jedno miesto (3D), aj keď je lišta užšia než tlačidlo.
+  const capacity = Math.max(1, Math.floor((available - moreWidth) / slot));
+  const priority = [ids[0], activeId, besideId, ...ids].filter((id): id is string => id !== null && ids.includes(id));
+  const keep = new Set<string>();
+  for (const id of priority) {
+    if (keep.size >= capacity) break;
+    keep.add(id);
+  }
+  return { visible: ids.filter((id) => keep.has(id)), hidden: ids.filter((id) => !keep.has(id)) };
+}
