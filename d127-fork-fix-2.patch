---
 apps/viewer/src/aim/AimBridge.tsx | 2 +-
 apps/viewer/src/aim/aimPanels.ts  | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/apps/viewer/src/aim/AimBridge.tsx b/apps/viewer/src/aim/AimBridge.tsx
index 522976d4..9a50b30a 100644
--- a/apps/viewer/src/aim/AimBridge.tsx
+++ b/apps/viewer/src/aim/AimBridge.tsx
@@ -268,7 +268,7 @@ export function AimBridge() {
       useCapturePinsStore.getState().setPins([]);
       useAimDecorationsStore.getState().clear();
       useAimDerivationsStore.getState().clear();
-      useAimDocRegionStore.setState({ request: null, highlights: null }); // D-117/D-123: výrez ani rámiky nepatria ďalšej relácii
+      useAimDocRegionStore.setState({ request: null, highlights: null, visible: null }); // D-117/D-123/D-127: výrez, rámiky ani rozsah nepatria ďalšej relácii
       resetLensFromChat(); // D-096: izolácia a AIM chat lens neprežijú odpojenie mostu
       setFocusProvider(undefined);
       resetCommandState(); // problémy a kroky z predošlej relácie nepatria do ďalšieho APPLIED
diff --git a/apps/viewer/src/aim/aimPanels.ts b/apps/viewer/src/aim/aimPanels.ts
index 9b0e0f31..a6a37651 100644
--- a/apps/viewer/src/aim/aimPanels.ts
+++ b/apps/viewer/src/aim/aimPanels.ts
@@ -39,8 +39,9 @@ function closePanel(s: Store, key: PanelKey): void {
       s.setListPanelVisible(false);
       return;
     case 'properties':
-      // Vlastnosti sú záloha pravého stĺpca: zavrieť ich = zbaliť stĺpec, keď ho práve držia.
-      if (s.sidebarActivePanel === 'properties' && s.sidebarMode !== 'collapsed') s.setSidebarMode('collapsed');
+      // Vlastnosti sú záloha pravého stĺpca: v spodnej polovici splitu ju uvoľnia, v hornej zbalia stĺpec.
+      if (s.sidebarSecondaryPanel === 'properties') s.setSidebarSecondaryPanel(null);
+      else if (s.sidebarActivePanel === 'properties' && s.sidebarMode !== 'collapsed') s.setSidebarMode('collapsed');
       return;
   }
 }
